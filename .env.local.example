# Room/event/signalling state lives in Firestore (see DEPLOY.md).
# Firebase Admin service account — server-side, keep secret:
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK config — client-side, safe to expose:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# AI Game Master
GEMINI_API_KEY=

# TURN relay for players behind symmetric NAT (see DEPLOY.md — Voice chat and TURN)
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_KEY_ID=

# Admin dashboard (/admin) — analytics over the match and session archives.
# Unset, the dashboard reports itself as not configured and serves nothing.
# Must be at least 16 characters: a short secret is worse than none, because it
# advertises a door that can be guessed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_DASHBOARD_TOKEN=
