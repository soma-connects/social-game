# Redis-backed room/signalling store (see DEPLOY.md).
#
# If you connected Redis through Vercel's Upstash Marketplace integration,
# use the KV_* names (that's what Vercel injects into the project — copy
# them from the project's Storage tab):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# If you created the database directly on upstash.com instead, use these
# names (from the database's "REST API" section) — either pair works:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Firebase. The NEXT_PUBLIC_* values are compiled into the browser bundle and
# are not secrets — firestore.rules is what guards the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side only. A real secret — never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Without a TURN relay, players behind symmetric NAT — which is
# normal on mobile networks — cannot connect a voice call at all.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
