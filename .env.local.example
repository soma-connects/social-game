# Room/event/signalling state lives in Firestore (see DEPLOY.md).
# Firebase Admin service account — server-side, keep secret:
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK config — client-side, safe to expose:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (reCAPTCHA Enterprise). The site key is public; it only
# works on the domains listed on the key in Google Cloud -> Security -> reCAPTCHA.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Local development only: a debug token registered in Firebase console ->
# App Check -> Apps -> (menu) -> Manage debug tokens. Ignored in production builds.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Server side: off | monitor | enforce. Defaults to monitor, which logs requests
# without a valid App Check token but still serves them. Switch to enforce once
# the App Check metrics show nearly all traffic verified.
APP_CHECK_MODE=

# AI Game Master (also the backup streaming speech-to-text provider)
GEMINI_API_KEY=

# A sharper roaster for the AI Game Master (optional). With a key set, the
# Roast Room and Flirty & Wild vibes are voiced by Grok and every other vibe
# stays on Gemini. A room that has ever been public never uses Grok, and any
# Grok failure falls back to Gemini, so a wrong model name costs a joke and not
# the round. AI_HOST_PROVIDER=grok uses it for every vibe; =gemini switches it
# off. XAI_MODEL defaults to grok-4-fast-non-reasoning (low latency matters:
# the room is waiting on the line).
XAI_API_KEY=
XAI_MODEL=
AI_HOST_PROVIDER=

# Streaming speech-to-text for voice games. Server-side only — the browser gets
# 30-second tokens from /api/stt-token. The key needs the Member role or higher
# in Deepgram, or minting those tokens fails with 403.
DEEPGRAM_API_KEY=

# TURN relay for players behind symmetric NAT (see DEPLOY.md — Voice chat and TURN)
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_KEY_ID=

# Admin dashboard (/admin) — analytics over the match and session archives.
# Unset, the dashboard reports itself as not configured and serves nothing.
# Must be at least 16 characters: a short secret is worse than none, because it
# advertises a door that can be guessed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_DASHBOARD_TOKEN=

# Local play without a Firebase project (optional, development only — ignored
# in production builds). Start the emulators with
#   npx firebase-tools emulators:start --project demo-party --only firestore,auth
# then set these, plus NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-party and any
# placeholder NEXT_PUBLIC_FIREBASE_API_KEY. The FIRESTORE_/FIREBASE_AUTH_ pair
# points the server (Admin SDK) at the emulators; the NEXT_PUBLIC_ pair points
# the browser at them.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
