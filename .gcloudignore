# What NOT to upload to Cloud Build.
#
# This governs the source tarball only. The image contents are controlled
# separately by .dockerignore.

.gcloudignore
.git
.gitignore
.next/
.next/**
node_modules/
node_modules/**
npm-debug.log
PROJECT_GOALS.md

# Firebase deploy cache — hundreds of MB, rebuilt on every deploy.
.firebase/
.firebase/**
.claude/
.claude/**

# A git worktree left at an old commit. .next, .git and node_modules are already
# skipped wherever they sit, so what is left of it is a second, older copy of the
# whole source tree: 23MB that doubles the upload, and nothing builds from it.
.deploy-origin-main/
.deploy-origin-main/**

# Env files. The build gets the public Firebase config through --build-arg and
# the Gemini key at runtime, so no env file ever needs to leave this machine.
.env
.env.*

# Source/reference art. Nothing under src/ imports these and they are the
# single largest thing in the upload — roughly 4MB of PNGs that would be sent
# on every build for nothing.
public/designs/
public/designs/**

# Local service account keys, if one is ever downloaded again.
sa-key.json
*serviceAccountKey*.json
