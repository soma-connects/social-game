rules_version = '2';

// Security model
// --------------
// The room API (/api/room/[roomId]) is the only thing allowed to change game
// state. It runs server-side on the Firebase Admin SDK, which bypasses these
// rules entirely — so everything a browser can reach is locked to read-only.
//
// Clients still read the room directly, via an onSnapshot subscription, because
// that is what makes the game live. Anything a player must NOT see before the
// reveal — trivia answers, the Truth or Bluff lie, per-player auth tokens —
// lives under rooms/{roomId}/private, which no client may read at all.

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // Knowing the room code is the only credential the game has ever had; it
      // is what gets pasted into WhatsApp to invite people. Reads stay open so
      // players and spectators can follow along without signing in.
      allow read: if true;

      // Never writable from a browser. A client that could write here could set
      // its own score, teleport to the finish line, or delete the room.
      allow write: if false;

      // Secrets. Not readable by anyone but the Admin SDK.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // Permanent history, written only by the Admin SDK when a match ends.
    //
    // Closed to browsers in both directions. Reads are closed because a match
    // row names everyone who played it, and there is no product reason for one
    // player to enumerate another's history; anything the game wants to show
    // should come through an API route that decides what to reveal. Writes are
    // closed for the obvious reason — a client that could write here could
    // invent wins, and once purchases hang off these totals, invent balances.
    match /matches/{matchId} {
      allow read, write: if false;
    }

    // Usage funnel: one row per room opening, written only by the Admin SDK.
    //
    // Closed to browsers for the same reason as matches, plus one of its own:
    // these rows are what the admin dashboard reads, and a client that could
    // write here could manufacture the usage numbers the product is steered by.
    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    // Lifetime totals per Firebase Auth uid.
    //
    // Deliberately not "allow read: if request.auth.uid == playerId". That rule
    // looks reasonable and would be a mistake here: it hands the browser a
    // direct, un-mediated view of the document that entitlements will live in,
    // and every future field on it becomes readable by default. Serve it
    // through an API route that returns only what the screen needs.
    match /players/{playerId} {
      allow read, write: if false;
    }

    // Anything not explicitly matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
